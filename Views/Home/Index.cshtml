@{
    ViewData["Title"] = "Home Page";
}

<!-- Home page -->
<div class="d-flex flex-column justify-content-center align-items-center text-center py-5 animate-fade-in" style="min-height: 80vh;">
    <div class="animate-slide-up">
        <h1 class="display-3 fw-bold mb-3">Welcome to Quizzly</h1>
        <p class="lead text-muted mb-4">Test your knowledge and have fun!</p>
        
        <!-- The bear image is displayed in a circle. -->
        <div class="mb-4">
            <div class="d-inline-block p-4 bg-white rounded-circle shadow bear-hover">
                <img src="~/images/bear.png" alt="Quiz Bear" class="img-fluid" style="max-width:175px;">
            </div>
        </div>
        
        <!-- Display the buttons to take a quiz or create a quiz. -->
        <div class="pt-3">
            <a class="btn btn-primary btn-lg mx-2 btn-hover" asp-controller="Quiz" asp-action="Index">Take a Quiz</a>
            <a class="btn btn-outline-secondary btn-lg mx-2 btn-hover" asp-controller="Quiz" asp-action="Create">Create a Quiz</a>
        </div>
    </div>
</div>
