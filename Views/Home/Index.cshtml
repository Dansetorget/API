@{
    ViewData["Title"] = "Home Page";
}


<div class="d-flex flex-column justify-content-center align-items-center text-center py-5" style="min-height: 80vh;">
    <h1 class="display-3 fw-bold mb-3">Welcome to Quizzly</h1>
    <p class="lead text-muted mb-4">Test your knowledge and have fun!</p>
    <img src="~/images/bear.png" alt="Quiz Bear" class="img-fluid mb-4" style="max-width:200px;">
    <div>
        <a class="btn btn-primary btn-lg mx-2" asp-controller="Quiz" asp-action="Index">Take a Quiz</a>
        <a class="btn btn-outline-secondary btn-lg mx-2" asp-controller="Quiz" asp-action="Create">Create a Quiz</a>
    </div>
</div>
