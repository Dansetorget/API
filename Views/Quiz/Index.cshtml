@model IEnumerable<QuizApp.Models.Quiz>

@{
    ViewData["Title"] = "Quizer";
}

<div class="container-fluid py-5 px-3 px-md-5">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-2">
        <div>
            <h2>Quizer</h2>
            <small class="text-muted">Test your knowledge and have fun</small>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No quizzes available
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var quiz in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-1">@quiz.Title</h5>
                            <small class="text-muted mb-3">@quiz.TotalQuestions @(quiz.TotalQuestions == 1 ? "spørsmål" : "spørsmål")</small>
                            <p class="card-text flex-grow-1">@(!string.IsNullOrWhiteSpace(quiz.Description) ? quiz.Description : "Ingen beskrivelse")</p>
                            <div class="mt-3 d-flex justify-content-end">
                                <a asp-controller="Quiz" asp-action="StartQuiz" asp-route-id="@quiz.QuizId" class="btn btn-outline-primary">
                                    Start Quiz 🐾
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>