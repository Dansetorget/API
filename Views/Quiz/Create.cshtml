@model CreateQuizViewModel
@{
    ViewData["Title"] = "Create Quiz";
}
<div class="d-flex flex-column justify-content-center align-items-center">
    <div class="container shadow card p-3 my-5 rounded">
        <h1 class="display-5 text-center">Opprett quiz</h1>
        <form asp-controller="Quiz" asp-action="Create" method="post" id="createQuizForm">
            <div class="mb-3"> 
                <h5>Tittel</h5> 
                <input asp-for="Title" class="form-control" /> 
                <span asp-validation-for="Title" class="text-danger"></span> 
            </div>
            <div class="mb-3">
                <h5>Beskrivelse</h5>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </form>
    </div>
    <div class="container mb-5">
        <h5 class="mb-3">Spørsmål</h5>
        <div class=" d-flex flex-column gap-4">
            @foreach (var q in Model.Questions)
            {
                var collapseId = $"collapse-q-{q.Id}";
                <div class="container card p-2 shadow-sm">
                    <div class="d-flex flex-row align-items-center justify-content-between">
                        <h5 class="mb-0">@q.QuestionText</h5>
                        <div class="d-flex flex-row gap-2">
                            <button type="button" class="btn btn-secondary w-fit" data-bs-toggle="collapse"
                                data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                Endre
                            </button>
                            <button class="btn btn-outline-danger w-fit">Slett</button>
                        </div>
                    </div>
                    <div id="@collapseId" class="collapse mt-3">
                        <div>
                            <p class=" mt-3 mb-0">Svaralternativer</p>
                            <p class="fw-light text-muted">Huk av for riktig svar</p>
                        </div>
                        <div class="row row-cols-2 g-2">
                        @foreach (var a in q.Answers){
                            <div class="col">
                                <div class="input-group">
                                    <div class="input-group-text">
                                        <input class="form-check-input mt-0" type="checkbox" name="Answers[3].IsCorrect" checked="@a.IsCorrect" aria-label="Checkbox for following text input">
                                        <input type="hidden" name="Answers[3].IsCorrect" value="@a.IsCorrect" />
                                    </div>
                                    <input type="text" class="form-control" value="@a.AnswerText"
                                        placeholder="Skriv svaralternativ tekst" />
                                </div>
                            </div>
                        }
                        </div>
                        <button class="btn btn-outline-primary mt-2" type="button">Lagre</button>
                    </div>
                </div>
            }
        </div>
        <div class=" mt-4">
            <form asp-controller="Quiz" asp-action="AddQuestionToList" method="post" class="d-flex flex-column card gap-2 p-3">
                <div class="d-flex flex-row gap-2">
                    <input type="text" class="form-control py-3 shadow" name="QuestionText" placeholder="Skriv spørsmålstekst " />
                </div>
                <div class=" mt-3">
                <p>Svaralternativer</p>
                <div class="row  gap-2">
                    <div class="input-group mb-3 col">
                        <div class="input-group-text">
                            <input class="form-check-input mt-0" type="checkbox" name="Answers[0].IsCorrect" value="true" aria-label="Checkbox for following text input">
                            <input type="hidden" name="Answers[0].IsCorrect" value="false" />
                        </div>
                        <input type="text" class="form-control" name="Answers[0].AnswerText" aria-label="Text input with checkbox">
                    </div>
                    <div class="input-group mb-3 col">
                        <div class="input-group-text">
                            <input class="form-check-input mt-0" type="checkbox" name="Answers[1].IsCorrect" value="true" aria-label="Checkbox for following text input">
                            <input type="hidden" name="Answers[1].IsCorrect" value="false" />
                        </div>
                        <input type="text" class="form-control" name="Answers[1].AnswerText" aria-label="Text input with checkbox">
                    </div>
                </div>
                <div class="row  gap-2">
                    <div class="input-group mb-3 col">
                        <div class="input-group-text">
                            <input class="form-check-input mt-0" type="checkbox" name="Answers[2].IsCorrect" value="true" aria-label="Checkbox for following text input">
                            <input type="hidden" name="Answers[2].IsCorrect" value="false" />
                        </div>
                        <input type="text" class="form-control" name="Answers[2].AnswerText" aria-label="Text input with checkbox">
                    </div>
                    <div class="input-group mb-3 col">
                        <div class="input-group-text">
                            <input class="form-check-input mt-0" type="checkbox" name="Answers[3].IsCorrect" value="true" aria-label="Checkbox for following text input">
                            <input type="hidden" name="Answers[3].IsCorrect" value="false" />
                        </div>
                        <input type="text" class="form-control" name="Answers[3].AnswerText" aria-label="Text input with checkbox">
                    </div>
                </div>
                <div class="bg-white rounded-3">
                        <button type="submit" class="btn btn-outline-primary text-nowrap py-1">Legg til</button>
                    </div>
            </form>
        </div>
        <button type="submit" form="createQuizForm" class="btn btn-secondary w-25 mt-4">Opprett Quiz</button>
        </div>
    </div>
</div>






