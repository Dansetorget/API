@{
    ViewData["Title"] = "Create Quiz";
}
<div class="d-flex flex-column justify-content-center align-items-center">
<div class="container shadow card p-3 my-5 rounded">
    <h1 class="display-5 text-center">Opprett quiz</h1>
    <form>
        <div class="mb-3">
        <h5>Tittel</h5>
            <input type="text" class="form-control" id="title" name="title" value="">
        </div>
        <div class="mb-3">
            <h5>Beskrivelse</h5>
            <textarea class="form-control" id="description" name="description"></textarea>
        </div>
    </form>
</div>
<div class="container mb-5">
    <h5 class="mb-3">Spørsmål</h5>
    <div class=" d-flex flex-column gap-4">
        @foreach (var q in new List<QuestionItemViewModel>())
        {
            var collapseId = $"collapse-q-{q.Id}";
            <div class="container card p-2 shadow-sm">
                <div class="d-flex flex-row align-items-center justify-content-between">
                    <h5 class="mb-0">@q.Text</h5>
                    <div class="d-flex flex-row gap-2">
                        <button type="button"
                                class="btn btn-secondary w-fit"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="false"
                                aria-controls="@collapseId">
                            Endre
                        </button>
                        <button class="btn btn-outline-danger w-fit">Slett</button>
                    </div>
                </div>
                <div id="@collapseId" class="collapse mt-3">
                    <div class="input-group">
                        <span class="input-group-text">Tekst</span>
                        <input type="text" class="form-control" value="@q.Text" placeholder="Skriv spørsmålstekst" />
                    </div>
                    <div>
                        <p class=" mt-3 mb-0">Svaralternativer</p>
                        <p class="fw-light text-muted">Huk av for riktig svar</p>
                    </div>
                    <div class="row my-2">
                    @foreach (var a in new List<QuestionAnswerViewModel>())
                    {
                        <div class="col-6 mb-2 d-flex flex-column  form-group">
                            <input type="text" class="form-control" value="@a.Answer" placeholder="Skriv svar" />
                            <div class="d-flex flex-row gap-5">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input form-switch text-success" @(a.IsCorrect ? "checked" : "")/>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                    <button class="btn btn-outline-primary" type="button">Lagre</button>
                </div>
            </div>
        }
    </div>
    <button class="btn btn-secondary w-25 mt-4">Legg til spørsmål</button>
    </div>
</div>
</div>






