@baseUrl = http://localhost:5243/api

### Get all quizzes
GET {{baseUrl}}/QuizAPI

### Get quiz by ID
GET {{baseUrl}}/quiz/1

### Create a new quiz
POST {{baseUrl}}/quiz
Content-Type: application/json

{
  "title": "C# Basics",
  "description": "Test your knowledge of C# fundamentals"
}

### Update quiz
PUT {{baseUrl}}/quiz/1
Content-Type: application/json

{
  "title": "Updated C# Basics",
  "description": "Updated description"
}

### Delete quiz
DELETE {{baseUrl}}/quiz/1
